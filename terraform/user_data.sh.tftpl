#!/bin/bash
set -e

apt update -y
apt install -y docker.io awscli
systemctl enable --now docker

# Login to ECR (ignore failure — fallback handles it)
ECR_REGISTRY=$(echo ${ecr_repository_url} | cut -d/ -f1)
aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin $ECR_REGISTRY || true

# Pull image from ECR, fallback to local build
if docker pull ${ecr_repository_url}:${image_tag}; then
  IMAGE=${ecr_repository_url}:${image_tag}
else
  cd /opt
  if [ ! -d webrtc-screen-share ]; then
    apt install -y git
    git clone https://${github_token}@github.com/${github_repo}.git webrtc-screen-share
    cd /opt/webrtc-screen-share
    docker build -t webrtc-screen-share .
    IMAGE=webrtc-screen-share
  else
    cd /opt/webrtc-screen-share
    docker build -t webrtc-screen-share .
    IMAGE=webrtc-screen-share
  fi
fi

docker rm -f wss 2>/dev/null || true

PUBLIC_IP=$(curl -s --connect-timeout 5 http://169.254.169.254/latest/meta-data/public-ipv4 || echo "")
if [ -z "$PUBLIC_IP" ]; then
  echo "Warning: Could not get public IP from metadata, using hostname"
  PUBLIC_IP=$(hostname -f)
fi
docker run -d --restart unless-stopped -p 443:443 \
  -e PUBLIC_URL="https://$PUBLIC_IP" \
  --name wss $IMAGE
