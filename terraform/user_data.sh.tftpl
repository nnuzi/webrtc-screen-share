#!/bin/bash
set -e

apt update -y
apt install -y docker.io awscli
systemctl enable --now docker

# Login to ECR (ignore failure — fallback handles it)
ECR_REGISTRY=$(echo ${ecr_repository_url} | cut -d/ -f1)
aws ecr get-login-password --region ${aws_region} | docker login --username AWS --password-stdin $ECR_REGISTRY || true

# Pull image from ECR, fallback to local build
if docker pull ${ecr_repository_url}:${image_tag}; then
  IMAGE=${ecr_repository_url}:${image_tag}
else
  cd /opt
  if [ ! -d webrtc-screen-share ]; then
    apt install -y git
    git clone https://${github_token}@github.com/${github_repo}.git webrtc-screen-share
    cd /opt/webrtc-screen-share
    docker build -t webrtc-screen-share .
    IMAGE=webrtc-screen-share
  else
    cd /opt/webrtc-screen-share
    docker build -t webrtc-screen-share .
    IMAGE=webrtc-screen-share
  fi
fi

docker rm -f wss 2>/dev/null || true

docker run -d --restart unless-stopped -p 443:443 \
  --name wss $IMAGE

# Install cloudflared
curl -L https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -o /usr/local/bin/cloudflared
chmod +x /usr/local/bin/cloudflared

# Create cloudflared tunnel systemd service
cat > /etc/systemd/system/cloudflared-tunnel.service << 'EOF'
[Unit]
Description=Cloudflare Tunnel (Quick Tunnel)
After=docker.service
Requires=docker.service

[Service]
ExecStart=/usr/local/bin/cloudflared tunnel --url https://localhost:443 --no-tls-verify
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now cloudflared-tunnel
