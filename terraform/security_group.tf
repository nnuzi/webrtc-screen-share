resource "aws_security_group" "wss" {
  name        = "webrtc-screen-share-sg"
  description = "Allow SSH and HTTPS for WebRTC screen share"
  vpc_id      = aws_vpc.wss.id

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "wss-sg" }
}
